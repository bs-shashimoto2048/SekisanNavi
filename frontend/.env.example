# frontend/.env.example
#
# 開発時は本ファイルをコピーして frontend/.env.local を作成し、値を設定する。
#   cp .env.example .env.local
#
# VITE_BACKEND_URL: Backend(FastAPI)の接続先。Vite devサーバーが /api への
# リクエストをこのURLへ同一オリジンでプロキシする (vite.config.ts参照)。
# ポートを変更した場合、変更が必要なのはこの1箇所のみ。
VITE_BACKEND_URL=http://127.0.0.1:8000

# VITE_API_BASE_URL: 通常は設定不要 (既定で相対パス '/api/...' を使い、
# 上記プロキシ経由で解決される)。Frontend/Backendを別ホストへ分離配置する等、
# プロキシを使わず直接絶対URLで呼び出したい場合のみ設定する。
# VITE_API_BASE_URL=http://backend-host:8000
